{
  "name": "@zk-email/circom-contracts",
  "version": "1.0.0",
  "description": "Circom onchain verifier contracts for ZKEmail Blueprints",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "deploy": "forge script script/DeployZKEmailVerifier.s.sol --broadcast --non-interactive --rpc-url rpc_url",
    "deploy-dkim-registry": "forge script script/DeployDKIMRegistry.s.sol --broadcast --non-interactive --rpc-url rpc_url",
    "deploy-dkim-registry-mock": "forge script script/DeployDKIMRegistryMock.s.sol --broadcast --non-interactive --rpc-url rpc_url"
  },
  "dependencies": {
    "@zk-email/zk-email-verify": "github:zkemail/zk-email-verify#abe9d839d2518ef3f3f0a5fab2283fd672672dde"
  },
  "devDependencies": {
    "forge-std": "https://github.com/foundry-rs/forge-std"
  }
}
