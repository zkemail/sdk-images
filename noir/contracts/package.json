{
  "name": "@zk-email/noir-contracts",
  "version": "1.0.0",
  "description": "Noir onchain verifier contracts for ZKEmail Blueprints",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "build:polka": "hardhat compile",
    "deploy": "forge script script/DeployZKEmailVerifier.s.sol --broadcast --non-interactive --rpc-url rpc_url",
    "deploy:polka": "hardhat run hh-scripts/deploy-zk-email-verifier.ts --network polkadotHubTestnet",
    "verify": "bash script/verify-zk-email-verifier.sh",
    "verify:polka": "hardhat run hh-scripts/verify-zk-email-verifier.ts --network polkadotHubTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@parity/hardhat-polkadot": "^0.2.7",
    "@parity/hardhat-polkadot-resolc": "^0.2.3",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": "^25.3.3",
    "chai": "^4.2.0",
    "dotenv": "^17.3.1",
    "ethers": "^6.14.0",
    "forge-std": "https://github.com/foundry-rs/forge-std",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^1.0.8",
    "rxjs": "^7.8.2",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.9.3"
  }
}
